rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in [
          'hihig9@gmail.com',
          'koyamamika.me@gmail.com'
        ];
    }

    function isValidChatMessage() {
      return request.resource.data.keys().hasAll(['text', 'sender', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.sender in ['guest', 'hana'];
    }

    match /media-items/{itemId} {
      allow read, write: if true;

      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }

    // Visitors can create access logs; only signed-in admins can read/manage them.
    match /access-logs/{logId} {
      allow create: if true
        && request.resource.data.keys().hasAll([
          'visitedAt',
          'userAgent',
          'deviceType',
          'browser',
          'os'
        ])
        && request.resource.data.visitedAt is string
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 500
        && request.resource.data.deviceType in ['mobile', 'tablet', 'desktop']
        && request.resource.data.browser is string
        && request.resource.data.os is string;
      allow read, update, delete: if isAdmin();
    }

    // Shared playlist state used by all clients on the same app account/password.
    match /shared-state/{docId} {
      allow read, write: if true;
    }

    // Hana inbox: guests use localStorage UUID (get/write by id, no Auth).
    // Listing all threads is admin-only. Message "hana" sender requires admin.
    match /chatThreads/{threadId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidChatMessage()
          && (
            request.resource.data.sender == 'guest'
            || (isAdmin() && request.resource.data.sender == 'hana')
          );
        allow update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
