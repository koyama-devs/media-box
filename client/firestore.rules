rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in [
          'hihig9@gmail.com',
          'koyamamika.me@gmail.com'
        ];
    }

    function isValidChatMessage() {
      return request.resource.data.keys().hasAll(['text', 'sender', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.sender in ['guest', 'hana'];
    }

    function isValidChatMessageUpdate() {
      return request.resource.data.sender == resource.data.sender
        && request.resource.data.sender in ['guest', 'hana']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
    }

    // Reaction-only patches (array of {emoji, reactorId, count}) must always be allowed.
    function isReactionsOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }

    match /media-items/{itemId} {
      allow read, write: if true;

      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }

    match /access-logs/{logId} {
      allow create: if true
        && request.resource.data.keys().hasAll([
          'visitedAt',
          'userAgent',
          'deviceType',
          'browser',
          'os'
        ])
        && request.resource.data.visitedAt is string
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 500
        && request.resource.data.deviceType in ['mobile', 'tablet', 'desktop']
        && request.resource.data.browser is string
        && request.resource.data.os is string;
      allow read, update, delete: if isAdmin();
    }

    match /shared-state/{docId} {
      allow read, write: if true;
    }

    match /chatProfiles/{profileId} {
      allow read, write: if true;
    }

    match /pushTokens/{tokenId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['userKey', 'token'])
        && request.resource.data.userKey is string
        && request.resource.data.userKey.size() > 0
        && request.resource.data.userKey.size() <= 40
        && request.resource.data.token is string
        && request.resource.data.token.size() > 10
        && request.resource.data.token.size() <= 4096;
      allow delete: if true;
    }

    // Private shared-password app: owner (password hana) may list without Google admin.
    match /chatThreads/{threadId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidChatMessage();
        allow update: if isValidChatMessageUpdate() || isReactionsOnlyUpdate();
        allow delete: if true;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
