{
  "appId": "app.hanamediabox.mobile",
  "appName": "Hana Mediabox",
  "webDir": "www",
  "backgroundColor": "#0b1220",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0b1220",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b1220"
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0b1220"
  },
  "ios": {
    "backgroundColor": "#0b1220",
    "contentInset": "automatic",
    "preferredContentMode": "mobile"
  }
}
